{
  "name": "student-directory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch backend/index.js\" \"vite --config UI/vite.config.js\"",
    "build": "vite build --config UI/vite.config.js",
    "start": "node --env-file-if-exists=.env backend/index.js --serve-ui",
    "db:setup": "node --env-file-if-exists=.env DB/setup.js",
    "db:seed": "node --env-file-if-exists=.env DB/seed.js",
    "user:create": "node --env-file-if-exists=.env DB/create-user.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.9.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mssql": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  }
}
