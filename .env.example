NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173

# SQL Server must be running with TCP connections and SQL authentication enabled.
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=student_crud_dev
DB_USER=sa
DB_PASSWORD=replace_with_your_local_sql_server_password

# true is for your LOCAL SQL Server's self-signed certificate only.
DB_TRUST_CERTIFICATE=true

# Optional: use separate administrator credentials for database/account setup.
# Leave blank to use DB_USER and DB_PASSWORD for local development.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
