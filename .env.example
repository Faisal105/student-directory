NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DB_SERVER=
DB_PORT=1433
DB_NAME=student_crud_dev
DB_USER=
DB_PASSWORD=
# Separate operator credentials for migrations, seed, and user management.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
# Only for an isolated local/CI SQL Server with a self-signed certificate.
DB_TRUST_CERTIFICATE=false
# Leave false unless the deployment proxy topology has been verified.
TRUST_PROXY=false
